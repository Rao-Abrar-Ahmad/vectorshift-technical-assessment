{
  "name": "vectorshift-technical-assessment",
  "main": "backend/main.py",
  "compatibility_date": "2026-08-06",

  "compatibility_flags": [
    "python_workers"
  ],

  "assets": {
    "directory": "./frontend/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}